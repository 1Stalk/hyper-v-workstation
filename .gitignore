# ==============================================================================
# Hyper-V GPU-PV Gaming Cluster - Git Ignore Rules
# ==============================================================================

# Virtual Machine disks, images, and checkpoints
*.vhdx
*.vhd
*.avhdx
*.iso
*.img

# Hyper-V VM state, configuration, and runtime directories
VMs/
*.vmcx
*.vmrs
*.vsv

# Large executable binaries, libraries, and installers
*.exe
*.dll
*.msi
*.zip
*.rar
*.7z
*.tar.gz
*.sys

# Keep required tracked tools metadata / licenses
!tools/sing-box/LICENSE

# Staging folder (downloaded installers, extracted drivers, VDD packages)
staging/*
!staging/.gitkeep
!staging/README.md

# Tools directory dynamic downloads
tools/sing-box/*
!tools/sing-box/.gitkeep
!tools/sing-box/LICENSE
!tools/sing-box/README.md
tools/moonlight/

# Guest ISO directory (keep directory placeholder and instructions)
iso/*
!iso/.gitkeep
!iso/README.md

# Guest desktop software directory (keep directory placeholder and instructions)
software/desktop/*
!software/desktop/.gitkeep
!software/desktop/README.md

# Logs, temporary files, diagnostics, and registry dumps
*.log
*.tmp
*.bak
*.bin
*.reg
handle64.exe
diag_*.txt
run_*.ps1
test_*.ps1

# Configuration files containing credentials
config/proxy-profiles.json
config/sing-box.json
!config/proxy-profiles.example.json

# Keep .gitkeep and documentation files in placeholder folders
!**/.gitkeep
!**/README.md

# OS-generated files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# IDE / Editor folders
.vscode/
.idea/
.example/
